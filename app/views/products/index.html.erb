<% content_for(:title) { "Stock Management — MobileStock Pro" } %>

<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Stock Management</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1">Manage your mobile and accessory inventory</p>
  </div>
  <% if current_user.can_manage_products? %>
    <%= link_to new_product_path, class: "btn btn-primary", id: "add-product-btn" do %>➕ Add Product<% end %>
  <% end %>
</div>

<div class="relative mb-5" data-controller="search" data-search-url-value="<%= products_path %>">
  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-txt-muted)] pointer-events-none text-base">🔍</span>
  <input type="text" id="product-search" placeholder="Search by name, brand, model, IMEI..." data-search-target="input" data-action="input->search#perform" value="<%= params[:query] %>" autocomplete="off" class="form-input !pl-12 !rounded-xl" style="background:var(--color-bg-card);backdrop-filter:blur(12px)">
</div>

<div class="flex gap-1.5 mb-5 flex-wrap">
  <%= link_to "All", products_path(query: params[:query]), class: "filter-tab #{'active' if params[:category].blank? && params[:stock_filter].blank?}", id: "filter-all" %>
  <%= link_to "📱 Mobiles", products_path(category: "mobile", query: params[:query]), class: "filter-tab #{'active' if params[:category] == 'mobile'}", id: "filter-mobiles" %>
  <%= link_to "🎧 Accessories", products_path(category: "accessory", query: params[:query]), class: "filter-tab #{'active' if params[:category] == 'accessory'}", id: "filter-accessories" %>
  <%= link_to "⚠️ Low Stock", products_path(stock_filter: "low", query: params[:query]), class: "filter-tab #{'active' if params[:stock_filter] == 'low'}", id: "filter-low-stock" %>
  <%= link_to "🔴 Out of Stock", products_path(stock_filter: "out", query: params[:query]), class: "filter-tab #{'active' if params[:stock_filter] == 'out'}", id: "filter-out-of-stock" %>
</div>

<turbo-frame id="products-list">
  <% if @products.any? %>
    <div class="overflow-x-auto rounded-2xl border border-[var(--color-border)] animate-in" style="background:var(--color-bg-card);backdrop-filter:blur(12px)">
      <table class="data-table" id="products-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Brand</th>
            <th>Category</th>
            <th>Selling Price</th>
            <% unless current_user.staff? %><th>Cost Price</th><% end %>
            <th>Stock</th>
            <th>Status</th>
            <% if current_user.can_manage_products? %><th>Actions</th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr id="product-row-<%= product.id %>">
              <td>
                <strong><%= product.name %></strong>
                <% if product.mobile? && product.imei.present? %><br><span class="text-[var(--color-txt-muted)] text-xs">IMEI: <%= product.imei %></span><% end %>
                <% if product.color.present? || product.storage.present? %><br>
                  <% if product.color.present? %><span class="text-[var(--color-txt-muted)] text-xs">Color: <%= product.color %></span><% end %>
                  <% if product.storage.present? %><span class="text-[var(--color-txt-muted)] text-xs"> | <%= product.storage %></span><% end %>
                <% end %>
              </td>
              <td><%= product.brand || '—' %></td>
              <td>
                <span class="badge badge-<%= product.category %>"><%= product.category == 'mobile' ? '📱' : '🎧' %> <%= product.category %></span>
                <% if product.accessory? && product.accessory_type.present? %><br><span class="text-[var(--color-txt-muted)] text-xs"><%= product.accessory_type.humanize %></span><% end %>
              </td>
              <td>₹<%= number_with_delimiter(product.selling_price.to_i) %></td>
              <% unless current_user.staff? %>
                <td>
                  <% if product.purchase_price.present? %>
                    <span class="text-[var(--color-txt-muted)]">₹<%= number_with_delimiter(product.purchase_price.to_i) %></span>
                  <% else %>—<% end %>
                </td>
              <% end %>
              <td>
                <% if current_user.can_manage_products? %>
                  <div class="inline-flex items-center gap-0.5 rounded-lg p-0.5" style="background:var(--color-bg-glass)">
                    <%= button_to adjust_stock_product_path(product, adjustment: -1), method: :patch, class: "stock-btn minus", title: "Decrease stock", disabled: product.quantity == 0 do %>−<% end %>
                    <span class="min-w-[36px] text-center font-bold text-sm text-[var(--color-txt-primary)]"><%= product.quantity %></span>
                    <%= button_to adjust_stock_product_path(product, adjustment: 1), method: :patch, class: "stock-btn plus", title: "Increase stock" do %>+<% end %>
                  </div>
                <% else %>
                  <span class="font-bold text-[var(--color-txt-primary)]"><%= product.quantity %></span>
                <% end %>
              </td>
              <td>
                <span class="badge badge-<%= product.stock_status == 'in_stock' ? 'success' : (product.stock_status == 'low_stock' ? 'warning' : 'danger') %>"><%= product.stock_status_label %></span>
              </td>
              <% if current_user.can_manage_products? %>
                <td>
                  <div class="flex gap-2">
                    <%= link_to edit_product_path(product), class: "btn btn-sm btn-secondary", id: "edit-product-#{product.id}", data: { turbo_frame: "_top" } do %>✏️<% end %>
                    <% if current_user.superadmin? %>
                      <%= button_to product_path(product), method: :delete, class: "btn btn-sm btn-danger", data: { turbo_confirm: "Are you sure you want to delete #{product.name}?" }, id: "delete-product-#{product.id}" do %>🗑️<% end %>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 animate-in">
      <div class="text-5xl mb-4 opacity-50">📦</div>
      <div class="text-base text-[var(--color-txt-muted)] mb-5">
        <% if params[:query].present? %>No products found matching "<%= params[:query] %>"
        <% else %>No products in stock yet.<% end %>
      </div>
      <% if current_user.can_manage_products? %>
        <%= link_to new_product_path, class: "btn btn-primary" do %>➕ Add Product<% end %>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
