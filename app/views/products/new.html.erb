<% content_for(:title) { "Add Product — MobileStock Pro" } %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Add New Product</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1">Add a new mobile or accessory to your inventory</p>
  </div>
  <%= link_to products_path, class: "btn btn-secondary" do %>← Back to Stock<% end %>
</div>
<%= render "form", product: @product %>
