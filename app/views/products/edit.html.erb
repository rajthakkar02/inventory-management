<% content_for(:title) { "Edit #{@product.name} — MobileStock Pro" } %>

<div class="page-header">
  <div>
    <h1 class="page-title">Edit Product</h1>
    <p class="page-subtitle">Update details for <%= @product.display_name %></p>
  </div>
  <%= link_to products_path, class: "btn btn-secondary" do %>
    ← Back to Stock
  <% end %>
</div>

<%= render "form", product: @product %>
