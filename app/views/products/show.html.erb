<% content_for(:title) { "#{@product.display_name} — MobileStock Pro" } %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title"><%= @product.display_name %></h1>
    <p class="text-sm mt-1">
      <span class="badge badge-<%= @product.category %>"><%= @product.category == 'mobile' ? '📱' : '🎧' %> <%= @product.category.capitalize %></span>
      <span class="badge badge-<%= @product.stock_status == 'in_stock' ? 'success' : (@product.stock_status == 'low_stock' ? 'warning' : 'danger') %>"><%= @product.stock_status_label %> (<%= @product.quantity %>)</span>
    </p>
  </div>
  <div class="flex gap-2">
    <% if current_user.can_manage_products? %>
      <%= link_to edit_product_path(@product), class: "btn btn-secondary" do %>✏️ Edit<% end %>
    <% end %>
    <%= link_to products_path, class: "btn btn-secondary" do %>← Back<% end %>
  </div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5 mb-7">
  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4">📋 Product Details</div>
    <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Brand</span><span class="font-semibold text-[var(--color-txt-primary)]"><%= @product.brand || '—' %></span></div>
    <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Model</span><span class="font-semibold text-[var(--color-txt-primary)]"><%= @product.model_number || '—' %></span></div>
    <% if @product.mobile? %>
      <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">IMEI</span><span class="font-semibold text-[var(--color-txt-primary)] font-mono"><%= @product.imei || '—' %></span></div>
      <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Storage</span><span class="font-semibold text-[var(--color-txt-primary)]"><%= @product.storage || '—' %></span></div>
      <div class="flex items-center justify-between py-2.5"><span class="text-xs text-[var(--color-txt-muted)]">Color</span><span class="font-semibold text-[var(--color-txt-primary)]"><%= @product.color || '—' %></span></div>
    <% end %>
    <% if @product.accessory? %>
      <div class="flex items-center justify-between py-2.5"><span class="text-xs text-[var(--color-txt-muted)]">Type</span><span class="font-semibold text-[var(--color-txt-primary)]"><%= @product.accessory_type&.humanize || '—' %></span></div>
    <% end %>
  </div>

  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4">💰 Pricing & Stock</div>
    <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Selling Price</span><span class="font-semibold text-[var(--color-success)]">₹<%= number_with_delimiter(@product.selling_price.to_i) %></span></div>
    <% unless current_user.staff? %>
      <% if @product.purchase_price.present? %>
        <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Purchase Price</span><span class="font-semibold text-[var(--color-txt-primary)]">₹<%= number_with_delimiter(@product.purchase_price.to_i) %></span></div>
        <div class="flex items-center justify-between py-2.5 border-b border-[var(--color-border-light)]"><span class="text-xs text-[var(--color-txt-muted)]">Profit per Unit</span><span class="font-semibold text-[var(--color-success)]">₹<%= number_with_delimiter(@product.profit_per_unit.to_i) %></span></div>
      <% end %>
    <% end %>
    <div class="flex items-center justify-between py-2.5"><span class="text-xs text-[var(--color-txt-muted)]">Current Stock</span><span class="font-bold text-[var(--color-txt-primary)]"><%= @product.quantity %></span></div>
    <% if @product.description.present? %>
      <div class="mt-4"><span class="text-xs text-[var(--color-txt-muted)]">Description</span><p class="text-[var(--color-txt-muted)] mt-1 text-sm"><%= @product.description %></p></div>
    <% end %>
  </div>
</div>

<% if @recent_sales.any? %>
  <div class="glass-card animate-in mt-6">
    <div class="flex items-center justify-between mb-5 pb-4 border-b border-[var(--color-border-light)]">
      <h3 class="text-base font-bold text-[var(--color-txt-primary)]">📋 Recent Sales</h3>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-[var(--color-border)]" style="background:var(--color-bg-card)">
      <table class="data-table">
        <thead><tr><th>Date</th><th>Qty</th><th>Price</th><th>Total</th><th>Salesman</th><th>Sold By</th></tr></thead>
        <tbody>
          <% @recent_sales.each do |sale| %>
            <tr>
              <td><%= sale.sold_at.strftime("%d %b %Y, %I:%M %p") %></td>
              <td><%= sale.quantity %></td>
              <td>₹<%= number_with_delimiter(sale.unit_price.to_i) %></td>
              <td class="text-[var(--color-success)] font-bold">₹<%= number_with_delimiter(sale.total_amount.to_i) %></td>
              <td><%= sale.salesman_name || sale.user.name %></td>
              <td class="text-[var(--color-txt-muted)]"><%= sale.user.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
