<div class="glass-card max-w-[720px] animate-in" data-controller="product-form">
  <% if product.errors.any? %>
    <div class="error-list">
      <h3>Please fix the following errors:</h3>
      <ul><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: product, html: { id: "product-form" } do |f| %>
    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5">Category *</label>
      <div class="flex gap-1.5 flex-wrap">
        <label class="filter-tab <%= 'active' if product.category == 'mobile' || product.category.blank? %>" data-action="click->product-form#selectCategory" data-product-form-category-param="mobile" id="category-mobile-tab">
          📱 Mobile Phone
          <%= f.radio_button :category, "mobile", style: "display:none", data: { product_form_target: "categoryRadio" }, checked: product.category == "mobile" || product.new_record? %>
        </label>
        <label class="filter-tab <%= 'active' if product.category == 'accessory' %>" data-action="click->product-form#selectCategory" data-product-form-category-param="accessory" id="category-accessory-tab">
          🎧 Accessory
          <%= f.radio_button :category, "accessory", style: "display:none", data: { product_form_target: "categoryRadio" }, checked: product.category == "accessory" %>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_name">Product Name *</label>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. iPhone 15 Pro Max", required: true, id: "product_name" %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_brand">Brand</label>
        <%= f.text_field :brand, class: "form-input", placeholder: "e.g. Apple, Samsung, Boat", id: "product_brand" %>
      </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_model_number">Model Number</label>
        <%= f.text_field :model_number, class: "form-input", placeholder: "e.g. A2849", id: "product_model_number" %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_quantity">Quantity in Stock *</label>
        <%= f.number_field :quantity, class: "form-input", min: 0, required: true, value: product.quantity || 1, id: "product_quantity" %>
      </div>
    </div>

    <div data-product-form-target="mobileFields" class="<%= 'hidden' if product.category == 'accessory' %>">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
        <div class="mb-5">
          <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_imei">IMEI Number</label>
          <%= f.text_field :imei, class: "form-input", placeholder: "15-digit IMEI number", id: "product_imei" %>
          <div class="text-xs text-[var(--color-txt-muted)] mt-1">Unique identifier for mobile devices</div>
        </div>
        <div class="mb-5">
          <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_storage">Storage</label>
          <%= f.select :storage, options_for_select([["Select Storage", ""], "64GB", "128GB", "256GB", "512GB", "1TB"], product.storage), {}, { class: "form-select", id: "product_storage" } %>
        </div>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_color">Color</label>
        <%= f.text_field :color, class: "form-input", placeholder: "e.g. Midnight Black, Silver", id: "product_color" %>
      </div>
    </div>

    <div data-product-form-target="accessoryFields" class="<%= 'hidden' unless product.category == 'accessory' %>">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_accessory_type">Accessory Type</label>
        <%= f.select :accessory_type, options_for_select([["Select Type", ""], ["📱 Phone Case", "case"], ["🔌 Charger", "charger"], ["🎧 Earphone/Headphone", "earphone"], ["🛡️ Screen Guard", "screen_guard"], ["🔗 Cable", "cable"], ["🔋 Power Bank", "power_bank"], ["🔊 Speaker", "speaker"], ["📦 Other", "other"]], product.accessory_type), {}, { class: "form-select", id: "product_accessory_type" } %>
      </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_purchase_price">Purchase Price (₹)</label>
        <%= f.number_field :purchase_price, class: "form-input", step: "0.01", min: 0, placeholder: "Cost price", id: "product_purchase_price" %>
        <div class="text-xs text-[var(--color-txt-muted)] mt-1">Your cost price (optional, used for profit calculation)</div>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_selling_price">Selling Price (₹) *</label>
        <%= f.number_field :selling_price, class: "form-input", step: "0.01", min: 0, placeholder: "MRP / Selling price", required: true, id: "product_selling_price" %>
      </div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="product_description">Description</label>
      <%= f.text_area :description, class: "form-textarea", placeholder: "Additional notes about this product...", rows: 3, id: "product_description" %>
    </div>

    <div class="flex gap-2 mt-4 flex-wrap">
      <%= f.submit product.persisted? ? "💾 Update Product" : "➕ Add to Stock", class: "btn btn-primary btn-lg", id: "product-submit" %>
      <%= link_to "Cancel", products_path, class: "btn btn-secondary btn-lg" %>
    </div>
  <% end %>
</div>
