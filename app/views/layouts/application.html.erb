<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "MobileStock Pro — Inventory Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Mobile shop stock management system — manage inventory, sales, and reports">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MobileStock Pro">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0a0e1a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? %>
      <div class="app-layout" data-controller="sidebar">
        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" data-action="click->sidebar#toggle" id="mobile-menu-toggle">
          ☰
        </button>
        <div class="mobile-overlay" data-sidebar-target="overlay" data-action="click->sidebar#close" id="mobile-overlay"></div>

        <!-- Sidebar -->
        <aside class="sidebar" data-sidebar-target="sidebar" id="main-sidebar">
          <div class="sidebar-brand">
            <div class="sidebar-brand-icon">📱</div>
            <div>
              <h1>MobileStock</h1>
              <span>Pro Dashboard</span>
            </div>
          </div>

          <nav class="sidebar-nav">
            <div class="sidebar-section">
              <div class="sidebar-section-title">Main</div>
              <%= link_to root_path, class: "sidebar-link #{'active' if controller_name == 'dashboard'}", id: "nav-dashboard" do %>
                <span class="sidebar-link-icon">📊</span>
                Dashboard
              <% end %>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-section-title">Inventory</div>
              <%= link_to products_path, class: "sidebar-link #{'active' if controller_name == 'products' && action_name == 'index'}", id: "nav-products" do %>
                <span class="sidebar-link-icon">📦</span>
                All Products
              <% end %>
              <%= link_to new_product_path, class: "sidebar-link #{'active' if controller_name == 'products' && action_name == 'new'}", id: "nav-add-product" do %>
                <span class="sidebar-link-icon">➕</span>
                Add Product
              <% end %>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-section-title">Sales</div>
              <%= link_to new_sale_path, class: "sidebar-link #{'active' if controller_name == 'sales' && action_name == 'new'}", id: "nav-new-sale" do %>
                <span class="sidebar-link-icon">🛒</span>
                New Sale
              <% end %>
              <%= link_to sales_path, class: "sidebar-link #{'active' if controller_name == 'sales' && action_name == 'index'}", id: "nav-sales-history" do %>
                <span class="sidebar-link-icon">📋</span>
                Sales History
              <% end %>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-section-title">Reports</div>
              <%= link_to daily_report_path, class: "sidebar-link #{'active' if controller_name == 'reports' && action_name == 'daily'}", id: "nav-daily-report" do %>
                <span class="sidebar-link-icon">📅</span>
                Today's Report
              <% end %>
              <%= link_to monthly_report_path, class: "sidebar-link #{'active' if controller_name == 'reports' && action_name == 'monthly'}", id: "nav-monthly-report" do %>
                <span class="sidebar-link-icon">📈</span>
                Monthly Report
              <% end %>
              <%= link_to financial_year_report_path, class: "sidebar-link #{'active' if controller_name == 'reports' && action_name == 'financial_year'}", id: "nav-fy-report" do %>
                <span class="sidebar-link-icon">💰</span>
                Financial Year
              <% end %>
            </div>

            <% if current_user&.owner? %>
              <div class="sidebar-section">
                <div class="sidebar-section-title">Admin</div>
                <%= link_to users_path, class: "sidebar-link #{'active' if controller_name == 'users'}", id: "nav-users" do %>
                  <span class="sidebar-link-icon">👥</span>
                  Staff Management
                <% end %>
              </div>
            <% end %>
          </nav>

          <div class="sidebar-user">
            <div class="sidebar-avatar"><%= current_user.name[0].upcase %></div>
            <div class="sidebar-user-info">
              <div class="sidebar-user-name"><%= current_user.name %></div>
              <div class="sidebar-user-role"><%= current_user.display_role %></div>
            </div>
            <%= button_to logout_path, method: :delete, class: "sidebar-logout", title: "Logout", id: "logout-btn" do %>
              🚪
            <% end %>
          </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>

    <!-- Flash Messages -->
    <% if flash.any? %>
      <div class="flash-container" data-controller="notification">
        <% flash.each do |type, message| %>
          <div class="flash-message <%= type %>" data-notification-target="message" data-action="click->notification#dismiss">
            <span><%= type == 'notice' ? '✅' : '⚠️' %></span>
            <span><%= message %></span>
            <button class="flash-dismiss" data-action="click->notification#dismiss">✕</button>
          </div>
        <% end %>
      </div>
    <% end %>
  </body>
</html>
