<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Login — MobileStock Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Login to MobileStock Pro — Mobile Shop Inventory Management">
    <meta name="theme-color" content="#0a0e1a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>

    <!-- Flash Messages -->
    <% if flash.any? %>
      <div class="flash-container" data-controller="notification">
        <% flash.each do |type, message| %>
          <div class="flash-message <%= type %>" data-notification-target="message" data-action="click->notification#dismiss">
            <span><%= type == 'notice' ? '✅' : '⚠️' %></span>
            <span><%= message %></span>
            <button class="flash-dismiss" data-action="click->notification#dismiss">✕</button>
          </div>
        <% end %>
      </div>
    <% end %>
  </body>
</html>
