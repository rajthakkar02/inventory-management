<div class="card form-card animate-in">
  <% if user.errors.any? %>
    <div class="error-list">
      <h3>Please fix the following errors:</h3>
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: user, html: { id: "user-form" } do |f| %>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="user_name">Full Name *</label>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. Rahul Kumar", required: true, id: "user_name" %>
      </div>
      <div class="form-group">
        <label class="form-label" for="user_email">Email Address *</label>
        <%= f.email_field :email, class: "form-input", placeholder: "e.g. rahul@shop.com", required: true, id: "user_email" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="user_password">Password <%= '*' unless user.persisted? %></label>
        <%= f.password_field :password, class: "form-input", placeholder: user.persisted? ? "Leave blank to keep current" : "Set a password", required: !user.persisted?, id: "user_password", autocomplete: "new-password" %>
        <% if user.persisted? %>
          <div class="form-hint">Leave blank to keep current password</div>
        <% end %>
      </div>
      <div class="form-group">
        <label class="form-label" for="user_password_confirmation">Confirm Password</label>
        <%= f.password_field :password_confirmation, class: "form-input", placeholder: "Re-enter password", id: "user_password_confirmation", autocomplete: "new-password" %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="user_role">Role *</label>
      <%= f.select :role, options_for_select([["Staff", "staff"], ["Owner (Admin)", "owner"]], user.role), {}, { class: "form-select", id: "user_role" } %>
      <div class="form-hint">Owners have full access. Staff can manage products and sales but cannot manage users.</div>
    </div>

    <div class="btn-group mt-2">
      <%= f.submit user.persisted? ? "💾 Update Staff" : "➕ Create Staff Account",
          class: "btn btn-primary btn-lg", id: "user-submit" %>
      <%= link_to "Cancel", users_path, class: "btn btn-secondary btn-lg" %>
    </div>
  <% end %>
</div>
