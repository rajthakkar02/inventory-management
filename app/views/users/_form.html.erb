<div class="glass-card max-w-[720px] animate-in">
  <% if user.errors.any? %>
    <div class="error-list">
      <h3>Please fix the following errors:</h3>
      <ul><% user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: user, html: { id: "user-form" } do |f| %>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="user_name">Full Name *</label>
        <%= f.text_field :name, class: "form-input", placeholder: "e.g. John Doe", required: true, id: "user_name" %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="user_email">Email Address *</label>
        <%= f.email_field :email, class: "form-input", placeholder: "e.g. john@shop.com", required: true, id: "user_email" %>
      </div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5">Role</label>
      <div class="form-input font-semibold" style="cursor:default;opacity:0.7">
        <% if user.persisted? %>
          <%= user.display_role %>
        <% else %>
          👤 Staff Member
        <% end %>
      </div>
      <div class="text-xs text-[var(--color-txt-muted)] mt-1">
        <% if user.persisted? %>Role cannot be changed<% else %>New accounts are created as Staff members<% end %>
      </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="user_password"><%= user.persisted? ? 'New Password' : 'Password *' %></label>
        <%= f.password_field :password, class: "form-input", placeholder: user.persisted? ? "Leave blank to keep current" : "Minimum 6 characters", required: !user.persisted?, id: "user_password" %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="user_password_confirmation">Confirm Password</label>
        <%= f.password_field :password_confirmation, class: "form-input", placeholder: "Re-enter password", id: "user_password_confirmation" %>
      </div>
    </div>

    <div class="flex gap-2 mt-4 flex-wrap">
      <%= f.submit user.persisted? ? "💾 Update User" : "➕ Create Staff Member", class: "btn btn-primary btn-lg", id: "user-submit" %>
      <%= link_to "Cancel", users_path, class: "btn btn-secondary btn-lg" %>
    </div>
  <% end %>
</div>
