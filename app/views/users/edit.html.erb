<% content_for(:title) { "Edit #{@user.name} — MobileStock Pro" } %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Edit User</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1">Update details for <%= @user.name %></p>
  </div>
  <%= link_to users_path, class: "btn btn-secondary" do %>← Back to Staff<% end %>
</div>
<%= render "form", user: @user %>
