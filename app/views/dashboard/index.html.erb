<% content_for(:title) { "Dashboard — MobileStock Pro" } %>

<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1">Welcome back, <%= current_user.name %>! Here's your shop overview.</p>
  </div>
  <div class="flex gap-2 flex-wrap">
    <%= link_to new_sale_path, class: "btn btn-primary", id: "quick-new-sale" do %>🛒 New Sale<% end %>
    <%= link_to new_product_path, class: "btn btn-secondary", id: "quick-add-product" do %>➕ Add Product<% end %>
  </div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5 mb-7">
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-success-bg)">💰</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1">₹<%= number_with_delimiter(@today_revenue.to_i) %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Today's Revenue</div>
  </div>
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-info-bg)">📦</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @today_items %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Items Sold Today</div>
  </div>
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:rgba(168,85,247,0.12)">🧾</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @today_transactions %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Transactions Today</div>
  </div>
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-warning-bg)">📱</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @total_in_stock %> / <%= @total_products %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Products in Stock</div>
  </div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-3.5 mb-7">
  <%= link_to new_sale_path, class: "flex items-center gap-3 p-[18px_20px] rounded-xl border border-[var(--color-border)] text-[var(--color-txt-primary)] font-semibold text-sm no-underline cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(102,126,234,0.3)] hover:shadow-[0_0_30px_rgba(102,126,234,0.15)]", style: "background:var(--color-bg-card)", id: "qa-new-sale" do %>
    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg shrink-0" style="background:var(--color-success-bg)">🛒</div>
    <span>Record Sale</span>
  <% end %>
  <%= link_to new_product_path, class: "flex items-center gap-3 p-[18px_20px] rounded-xl border border-[var(--color-border)] text-[var(--color-txt-primary)] font-semibold text-sm no-underline cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(102,126,234,0.3)] hover:shadow-[0_0_30px_rgba(102,126,234,0.15)]", style: "background:var(--color-bg-card)", id: "qa-add-product" do %>
    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg shrink-0" style="background:var(--color-info-bg)">➕</div>
    <span>Add Product</span>
  <% end %>
  <%= link_to daily_report_path, class: "flex items-center gap-3 p-[18px_20px] rounded-xl border border-[var(--color-border)] text-[var(--color-txt-primary)] font-semibold text-sm no-underline cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(102,126,234,0.3)] hover:shadow-[0_0_30px_rgba(102,126,234,0.15)]", style: "background:var(--color-bg-card)", id: "qa-daily-report" do %>
    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg shrink-0" style="background:rgba(168,85,247,0.12)">📊</div>
    <span>Today's Report</span>
  <% end %>
  <%= link_to products_path(stock_filter: "low"), class: "flex items-center gap-3 p-[18px_20px] rounded-xl border border-[var(--color-border)] text-[var(--color-txt-primary)] font-semibold text-sm no-underline cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(102,126,234,0.3)] hover:shadow-[0_0_30px_rgba(102,126,234,0.15)]", style: "background:var(--color-bg-card)", id: "qa-low-stock" do %>
    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg shrink-0" style="background:var(--color-warning-bg)">⚠️</div>
    <span>Low Stock (<%= @low_stock_products.size %>)</span>
  <% end %>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5 mb-7">
  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4 flex items-center gap-2">📈 This Month</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1">₹<%= number_with_delimiter(@month_revenue.to_i) %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Monthly Revenue</div>
  </div>

  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4 flex items-center gap-2">💳 Today's Payment Breakdown</div>
    <% if @payment_breakdown.any? %>
      <div class="flex flex-col gap-3">
        <% @payment_breakdown.each do |method, amount| %>
          <div class="flex items-center gap-3">
            <span class="breakdown-dot <%= method %>"></span>
            <span class="flex-1 text-sm text-[var(--color-txt-secondary)] uppercase font-medium"><%= method.upcase %></span>
            <span class="text-sm font-bold text-[var(--color-txt-primary)]">₹<%= number_with_delimiter(amount.to_i) %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-[var(--color-txt-muted)] text-sm">No sales recorded today yet.</p>
    <% end %>
  </div>

  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4 flex items-center gap-2">⚠️ Low Stock Alerts</div>
    <% if @low_stock_products.any? %>
      <% @low_stock_products.each do |product| %>
        <div class="flex items-center gap-3 py-2.5 border-b border-[var(--color-border-light)] last:border-b-0">
          <span class="badge badge-warning"><%= product.quantity %></span>
          <span class="flex-1 text-sm text-[var(--color-txt-primary)] font-medium"><%= product.display_name %></span>
          <span class="badge badge-<%= product.category == 'mobile' ? 'mobile' : 'accessory' %>"><%= product.category %></span>
        </div>
      <% end %>
    <% else %>
      <p class="text-[var(--color-txt-muted)] text-sm">All products are well-stocked! 🎉</p>
    <% end %>
  </div>

  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4 flex items-center gap-2">🕐 Recent Sales</div>
    <% if @recent_sales.any? %>
      <% @recent_sales.each do |sale| %>
        <div class="flex items-center gap-3 py-2.5 border-b border-[var(--color-border-light)] last:border-b-0">
          <div class="flex-1 text-sm text-[var(--color-txt-primary)] font-medium">
            <%= sale.product.display_name %>
            <span class="text-[var(--color-txt-muted)] text-xs"> × <%= sale.quantity %></span>
          </div>
          <div class="text-right">
            <div class="text-sm font-bold text-[var(--color-success)]">₹<%= number_with_delimiter(sale.total_amount.to_i) %></div>
            <div class="text-xs text-[var(--color-txt-muted)]"><%= time_ago_in_words(sale.sold_at) %> ago</div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-[var(--color-txt-muted)] text-sm">No sales recorded yet. Start selling!</p>
    <% end %>
  </div>
</div>

<% if @out_of_stock_products.any? %>
  <div class="glass-card animate-in mt-6">
    <div class="flex items-center justify-between mb-5 pb-4 border-b border-[var(--color-border-light)]">
      <h3 class="text-base font-bold text-[var(--color-txt-primary)]">🔴 Out of Stock Products</h3>
      <%= link_to "View All", products_path(stock_filter: "out"), class: "btn btn-sm btn-secondary" %>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-[var(--color-border)]" style="background:var(--color-bg-card)">
      <table class="data-table">
        <thead><tr><th>Product</th><th>Brand</th><th>Category</th><th>Selling Price</th></tr></thead>
        <tbody>
          <% @out_of_stock_products.each do |product| %>
            <tr>
              <td><strong><%= product.name %></strong></td>
              <td><%= product.brand || '—' %></td>
              <td><span class="badge badge-<%= product.category %>"><%= product.category %></span></td>
              <td>₹<%= number_with_delimiter(product.selling_price.to_i) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
