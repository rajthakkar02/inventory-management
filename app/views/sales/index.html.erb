<% content_for(:title) { "Sales History — MobileStock Pro" } %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Sales History</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1"><%= current_user.superadmin? ? "View and filter all sales records" : "View and filter your sales records" %></p>
  </div>
  <%= link_to new_sale_path, class: "btn btn-primary", id: "new-sale-btn" do %>🛒 New Sale<% end %>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5 mb-7">
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-success-bg)">💰</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1">₹<%= number_with_delimiter(@total_revenue.to_i) %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Total Revenue</div>
  </div>
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-info-bg)">📦</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @total_items %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Items Sold</div>
  </div>
  <div class="stat-card animate-in">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:rgba(168,85,247,0.12)">🧾</div>
    <div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @total_transactions %></div>
    <div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Transactions</div>
  </div>
</div>

<div class="flex gap-1.5 mb-5 flex-wrap">
  <%= link_to "All", sales_path, class: "filter-tab #{'active' if params[:date_filter].blank?}", id: "sales-filter-all" %>
  <%= link_to "Today", sales_path(date_filter: "today"), class: "filter-tab #{'active' if params[:date_filter] == 'today'}", id: "sales-filter-today" %>
  <%= link_to "This Week", sales_path(date_filter: "this_week"), class: "filter-tab #{'active' if params[:date_filter] == 'this_week'}", id: "sales-filter-week" %>
  <%= link_to "This Month", sales_path(date_filter: "this_month"), class: "filter-tab #{'active' if params[:date_filter] == 'this_month'}", id: "sales-filter-month" %>
</div>
<div class="flex gap-1.5 mb-5 flex-wrap">
  <%= link_to "All Payments", sales_path(date_filter: params[:date_filter]), class: "filter-tab #{'active' if params[:payment_method].blank?}", id: "pay-filter-all" %>
  <%= link_to "💵 Cash", sales_path(date_filter: params[:date_filter], payment_method: "cash"), class: "filter-tab #{'active' if params[:payment_method] == 'cash'}", id: "pay-filter-cash" %>
  <%= link_to "📱 UPI", sales_path(date_filter: params[:date_filter], payment_method: "upi"), class: "filter-tab #{'active' if params[:payment_method] == 'upi'}", id: "pay-filter-upi" %>
  <%= link_to "💳 Card", sales_path(date_filter: params[:date_filter], payment_method: "card"), class: "filter-tab #{'active' if params[:payment_method] == 'card'}", id: "pay-filter-card" %>
</div>

<% if @sales.any? %>
  <div class="overflow-x-auto rounded-2xl border border-[var(--color-border)] animate-in" style="background:var(--color-bg-card);backdrop-filter:blur(12px)">
    <table class="data-table" id="sales-table">
      <thead><tr><th>Date & Time</th><th>Product</th><th>Qty</th><th>Unit Price</th><th>Discount</th><th>Total</th><th>Payment</th><th>Salesman</th><th>Sold By</th></tr></thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td>
              <div><%= sale.sold_at.strftime("%d %b %Y") %></div>
              <span class="text-[var(--color-txt-muted)] text-xs"><%= sale.sold_at.strftime("%I:%M %p") %></span>
            </td>
            <td>
              <strong><%= sale.product.name %></strong>
              <% if sale.product.brand.present? %><br><span class="text-[var(--color-txt-muted)] text-xs"><%= sale.product.brand %></span><% end %>
            </td>
            <td><%= sale.quantity %></td>
            <td>₹<%= number_with_delimiter(sale.unit_price.to_i) %></td>
            <td><% if sale.discount.to_i > 0 %><span class="text-[var(--color-warning)]">-₹<%= number_with_delimiter(sale.discount.to_i) %></span><% else %>—<% end %></td>
            <td><strong class="text-[var(--color-success)]">₹<%= number_with_delimiter(sale.total_amount.to_i) %></strong></td>
            <td>
              <span class="badge badge-<%= sale.payment_method == 'cash' ? 'success' : (sale.payment_method == 'upi' ? 'info' : 'warning') %>">
                <%= sale.payment_method == 'cash' ? '💵' : (sale.payment_method == 'upi' ? '📱' : '💳') %> <%= sale.payment_method.upcase %>
              </span>
            </td>
            <td><%= sale.salesman_name || sale.user.name %></td>
            <td><span class="text-[var(--color-txt-muted)]"><%= sale.user.name %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 animate-in">
    <div class="text-5xl mb-4 opacity-50">🛒</div>
    <div class="text-base text-[var(--color-txt-muted)] mb-5">No sales found for the selected filters.</div>
    <%= link_to new_sale_path, class: "btn btn-primary" do %>🛒 Record First Sale<% end %>
  </div>
<% end %>
