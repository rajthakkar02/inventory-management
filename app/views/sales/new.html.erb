<% content_for(:title) { "New Sale — MobileStock Pro" } %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div>
    <h1 class="page-title">Record New Sale</h1>
    <p class="text-sm text-[var(--color-txt-muted)] mt-1">Select a product and record the sale</p>
  </div>
  <%= link_to sales_path, class: "btn btn-secondary" do %>← Sales History<% end %>
</div>

<div class="glass-card max-w-[720px] animate-in" data-controller="sale">
  <% if @sale.errors.any? %>
    <div class="error-list">
      <h3>Please fix the following errors:</h3>
      <ul><% @sale.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: @sale, html: { id: "sale-form" } do |f| %>
    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_product_id">Select Product *</label>
      <%= f.select :product_id,
          options_for_select(
            @products.map { |p| ["#{p.display_name} (Stock: #{p.quantity}) — ₹#{p.selling_price.to_i}", p.id, { "data-price" => p.selling_price, "data-stock" => p.quantity, "data-name" => p.display_name }] },
            @sale.product_id
          ),
          { include_blank: "— Choose a product —" },
          { class: "form-select", required: true, id: "sale_product_id",
            data: { action: "change->sale#productSelected", sale_target: "productSelect", url: product_info_path } } %>
    </div>

    <div class="product-info-card" data-sale-target="productInfo" id="selected-product-info">
      <div class="flex justify-between items-center py-1"><span class="text-xs text-[var(--color-txt-muted)]">Product</span><span class="font-semibold text-[var(--color-txt-primary)]" data-sale-target="productName">—</span></div>
      <div class="flex justify-between items-center py-1"><span class="text-xs text-[var(--color-txt-muted)]">Unit Price</span><span class="font-semibold text-[var(--color-txt-primary)]">₹<span data-sale-target="productPrice">0</span></span></div>
      <div class="flex justify-between items-center py-1"><span class="text-xs text-[var(--color-txt-muted)]">Available Stock</span><span class="font-semibold text-[var(--color-txt-primary)]" data-sale-target="productStock">0</span></div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_quantity">Quantity *</label>
        <%= f.number_field :quantity, class: "form-input", min: 1, value: @sale.quantity || 1, required: true, id: "sale_quantity", data: { action: "input->sale#calculate", sale_target: "quantity" } %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_unit_price">Unit Price (₹) *</label>
        <%= f.number_field :unit_price, class: "form-input", step: "0.01", min: 0, required: true, id: "sale_unit_price", data: { action: "input->sale#calculate", sale_target: "unitPrice" } %>
      </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_discount">Discount (₹)</label>
        <%= f.number_field :discount, class: "form-input", step: "0.01", min: 0, value: @sale.discount || 0, id: "sale_discount", data: { action: "input->sale#calculate", sale_target: "discount" } %>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5">Total Amount</label>
        <div class="form-input font-bold text-xl" style="background:rgba(16,185,129,0.1);border-color:rgba(16,185,129,0.3);color:var(--color-success)">
          ₹<span data-sale-target="totalDisplay" id="sale-total-display">0</span>
        </div>
      </div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5">Payment Method *</label>
      <div class="flex gap-1.5 flex-wrap">
        <label class="filter-tab active" id="pay-cash-tab">💵 Cash <%= f.radio_button :payment_method, "cash", checked: true, style: "display:none" %></label>
        <label class="filter-tab" id="pay-upi-tab">📱 UPI <%= f.radio_button :payment_method, "upi", style: "display:none" %></label>
        <label class="filter-tab" id="pay-card-tab">💳 Card <%= f.radio_button :payment_method, "card", style: "display:none" %></label>
      </div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_salesman_name">Salesman Name</label>
      <%= f.text_field :salesman_name, class: "form-input", placeholder: "Auto-filled with your name", value: current_user.name, id: "sale_salesman_name" %>
      <div class="text-xs text-[var(--color-txt-muted)] mt-1">Name of the person who sold this product</div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-[var(--color-txt-secondary)] mb-1.5" for="sale_notes">Notes</label>
      <%= f.text_area :notes, class: "form-textarea", placeholder: "Any additional notes about this sale...", rows: 2, id: "sale_notes" %>
    </div>

    <div class="flex gap-2 mt-4 flex-wrap">
      <%= f.submit "🛒 Record Sale", class: "btn btn-primary btn-lg", id: "sale-submit" %>
      <%= link_to "Cancel", sales_path, class: "btn btn-secondary btn-lg" %>
    </div>
  <% end %>
</div>
