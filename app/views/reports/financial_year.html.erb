<% content_for(:title) { "#{@fy_label} Report — MobileStock Pro" } %>
<% month_names = %w[Apr May Jun Jul Aug Sep Oct Nov Dec Jan Feb Mar] %>

<div class="page-header">
  <div>
    <h1 class="page-title">💰 Financial Year Report</h1>
    <p class="page-subtitle"><%= @fy_label %> (<%= @fy_start.strftime("%d %b %Y") %> – <%= @fy_end.strftime("%d %b %Y") %>)</p>
  </div>
  <div class="btn-group">
    <%= link_to export_csv_path, class: "btn btn-success", id: "export-csv-btn" do %>
      📥 Export CSV
    <% end %>
  </div>
</div>

<!-- FY Selector -->
<div class="month-selector mb-2">
  <form method="get" action="<%= financial_year_report_path %>" style="display: flex; gap: 10px; align-items: center;">
    <label class="form-label" style="margin-bottom: 0; white-space: nowrap;">Financial Year Starting:</label>
    <select name="fy_start_year" class="form-select" style="width: auto;" id="fy-year-select">
      <% (2024..Date.current.year + 1).each do |y| %>
        <option value="<%= y %>" <%= 'selected' if @fy_start.year == y %>>April <%= y %> — March <%= y + 1 %></option>
      <% end %>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
  </form>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card animate-in">
    <div class="stat-card-icon revenue">💰</div>
    <div class="stat-card-value">₹<%= number_with_delimiter(@total_revenue.to_i) %></div>
    <div class="stat-card-label">Annual Revenue</div>
  </div>
  <div class="stat-card animate-in">
    <div class="stat-card-icon items">📦</div>
    <div class="stat-card-value"><%= number_with_delimiter(@total_items) %></div>
    <div class="stat-card-label">Items Sold</div>
  </div>
  <div class="stat-card animate-in">
    <div class="stat-card-icon transactions">🧾</div>
    <div class="stat-card-value"><%= number_with_delimiter(@total_transactions) %></div>
    <div class="stat-card-label">Total Transactions</div>
  </div>
  <% if @estimated_profit.present? %>
    <div class="stat-card animate-in">
      <div class="stat-card-icon stock">📈</div>
      <div class="stat-card-value">₹<%= number_with_delimiter(@estimated_profit.to_i) %></div>
      <div class="stat-card-label">Est. Profit</div>
    </div>
  <% end %>
</div>

<!-- Monthly Breakdown Chart -->
<div class="card animate-in mb-3">
  <div class="card-header">
    <h3 class="card-title">📊 Month-by-Month Revenue</h3>
  </div>
  <% if @monthly_data.any? %>
    <% max_revenue = @monthly_data.map { |m| m.month_revenue.to_f }.max %>
    <div class="bar-chart" style="height: 220px;">
      <% @monthly_data.each do |month_data| %>
        <% month_date = Date.parse("#{month_data.sale_month}-01") %>
        <div class="bar-chart-item">
          <div class="bar-chart-value">₹<%= (month_data.month_revenue.to_i / 1000.0).round(1) %>k</div>
          <div class="bar-chart-bar" style="height: <%= max_revenue > 0 ? (month_data.month_revenue.to_f / max_revenue * 100).round : 5 %>%;" title="₹<%= number_with_delimiter(month_data.month_revenue.to_i) %>"></div>
          <div class="bar-chart-label"><%= month_date.strftime("%b") %></div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted" style="padding: 20px 0;">No sales data for this financial year.</p>
  <% end %>
</div>

<div class="report-grid">
  <!-- Payment Breakdown -->
  <div class="report-section animate-in">
    <div class="report-section-title">💳 Payment Method Summary</div>
    <% if @payment_breakdown.any? %>
      <% max_val = @payment_breakdown.values.max.to_f %>
      <div class="breakdown-list">
        <% @payment_breakdown.each do |method, amount| %>
          <div class="breakdown-item">
            <span class="breakdown-dot <%= method %>"></span>
            <span class="breakdown-label"><%= method.upcase %></span>
            <div class="breakdown-bar-track">
              <div class="breakdown-bar-fill <%= method %>" style="width: <%= max_val > 0 ? (amount / max_val * 100).round : 0 %>%"></div>
            </div>
            <span class="breakdown-value">₹<%= number_with_delimiter(amount.to_i) %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">No data available.</p>
    <% end %>
  </div>

  <!-- Category Breakdown -->
  <div class="report-section animate-in">
    <div class="report-section-title">📊 Category Revenue</div>
    <div class="breakdown-list">
      <% @category_breakdown.each do |cat, amount| %>
        <div class="breakdown-item">
          <span class="breakdown-dot <%= cat == 'Mobiles' ? 'upi' : 'cash' %>"></span>
          <span class="breakdown-label"><%= cat %></span>
          <span class="breakdown-value">₹<%= number_with_delimiter(amount.to_i) %></span>
        </div>
      <% end %>
    </div>
    <% total_cat = @category_breakdown.values.sum.to_f %>
    <% if total_cat > 0 %>
      <div class="mt-2">
        <% @category_breakdown.each do |cat, amount| %>
          <div class="text-muted" style="font-size: 0.8rem;"><%= cat %>: <%= (amount / total_cat * 100).round(1) %>%</div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Top Products -->
  <div class="report-section animate-in" style="grid-column: 1 / -1;">
    <div class="report-section-title">🏆 Top 10 Selling Products (<%= @fy_label %>)</div>
    <% if @top_products.any? %>
      <% @top_products.each_with_index do |product, index| %>
        <div class="top-product-item">
          <span class="top-product-rank"><%= index + 1 %></span>
          <span class="top-product-name"><%= product.brand %> <%= product.name %></span>
          <div class="top-product-stats">
            <div class="top-product-revenue">₹<%= number_with_delimiter(product.total_revenue.to_i) %></div>
            <div class="top-product-qty"><%= product.total_qty %> sold</div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted">No products sold in this financial year.</p>
    <% end %>
  </div>
</div>
