<% content_for(:title) { "Monthly Report — MobileStock Pro" } %>
<% month_names = %w[January February March April May June July August September October November December] %>
<div class="flex items-center justify-between flex-wrap gap-4 mb-7">
  <div><h1 class="page-title">📈 Monthly Report</h1><p class="text-sm text-[var(--color-txt-muted)] mt-1"><%= month_names[@month - 1] %> <%= @year %></p></div>
</div>

<div class="flex items-center gap-2.5 mb-5">
  <form method="get" action="<%= monthly_report_path %>" class="flex gap-2.5 items-center">
    <select name="month" class="form-select !w-auto" id="report-month-select"><% month_names.each_with_index do |name, i| %><option value="<%= i + 1 %>" <%= 'selected' if @month == i + 1 %>><%= name %></option><% end %></select>
    <select name="year" class="form-select !w-auto" id="report-year-select"><% (2024..Date.current.year + 1).each do |y| %><option value="<%= y %>" <%= 'selected' if @year == y %>><%= y %></option><% end %></select>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
  </form>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5 mb-7">
  <div class="stat-card animate-in"><div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-success-bg)">💰</div><div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1">₹<%= number_with_delimiter(@total_revenue.to_i) %></div><div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Monthly Revenue</div></div>
  <div class="stat-card animate-in"><div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-info-bg)">📦</div><div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @total_items %></div><div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Items Sold</div></div>
  <div class="stat-card animate-in"><div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:rgba(168,85,247,0.12)">🧾</div><div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1"><%= @total_transactions %></div><div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Transactions</div></div>
  <div class="stat-card animate-in"><div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-4" style="background:var(--color-warning-bg)">📊</div><div class="text-3xl font-extrabold text-[var(--color-txt-primary)] leading-none mb-1">₹<%= number_with_delimiter(@avg_daily.to_i) %></div><div class="text-xs text-[var(--color-txt-muted)] font-medium uppercase tracking-wide">Avg. Daily Revenue</div></div>
</div>

<div class="glass-card animate-in mb-6">
  <div class="flex items-center justify-between mb-5 pb-4 border-b border-[var(--color-border-light)]"><h3 class="text-base font-bold text-[var(--color-txt-primary)]">📊 Daily Revenue Breakdown</h3></div>
  <% if @daily_data.any? %>
    <% max_revenue = @daily_data.map { |d| d.day_revenue.to_f }.max %>
    <div class="flex items-end gap-2 h-[200px] pt-5">
      <% @daily_data.each do |day| %>
        <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end">
          <div class="text-[0.65rem] font-semibold text-[var(--color-txt-secondary)] whitespace-nowrap">₹<%= (day.day_revenue.to_i / 1000.0).round(1) %>k</div>
          <div class="bar-chart-bar" style="height:<%= max_revenue > 0 ? (day.day_revenue.to_f / max_revenue * 100).round : 5 %>%" title="₹<%= number_with_delimiter(day.day_revenue.to_i) %>"></div>
          <div class="text-[0.65rem] text-[var(--color-txt-muted)] text-center whitespace-nowrap"><%= Date.parse(day.sale_date.to_s).day %></div>
        </div>
      <% end %>
    </div>
  <% else %><p class="text-[var(--color-txt-muted)] py-5">No sales data for this month.</p><% end %>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5 mb-7">
  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4">💳 Payment Breakdown</div>
    <% if @payment_breakdown.any? %>
      <% max_val = @payment_breakdown.values.max.to_f %>
      <div class="flex flex-col gap-3"><% @payment_breakdown.each do |method, amount| %><div class="flex items-center gap-3"><span class="breakdown-dot <%= method %>"></span><span class="flex-1 text-sm text-[var(--color-txt-secondary)] uppercase font-medium"><%= method.upcase %></span><div class="flex-[2] h-1.5 rounded-sm overflow-hidden" style="background:var(--color-bg-glass)"><div class="breakdown-bar-fill <%= method %>" style="width:<%= max_val > 0 ? (amount / max_val * 100).round : 0 %>%"></div></div><span class="text-sm font-bold text-[var(--color-txt-primary)]">₹<%= number_with_delimiter(amount.to_i) %></span></div><% end %></div>
    <% else %><p class="text-[var(--color-txt-muted)]">No data available.</p><% end %>
  </div>
  <div class="glass-card animate-in">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4">📊 Category Breakdown</div>
    <div class="flex flex-col gap-3"><% @category_breakdown.each do |cat, amount| %><div class="flex items-center gap-3"><span class="breakdown-dot <%= cat == 'Mobiles' ? 'upi' : 'cash' %>"></span><span class="flex-1 text-sm text-[var(--color-txt-secondary)] font-medium"><%= cat %></span><span class="text-sm font-bold text-[var(--color-txt-primary)]">₹<%= number_with_delimiter(amount.to_i) %></span></div><% end %></div>
  </div>
  <div class="glass-card animate-in" style="grid-column:1/-1">
    <div class="text-[0.95rem] font-bold text-[var(--color-txt-primary)] mb-4">🏆 Top 10 Selling Products</div>
    <% if @top_products.any? %>
      <% @top_products.each_with_index do |product, index| %>
        <div class="flex items-center gap-3 py-2.5 border-b border-[var(--color-border-light)] last:border-b-0">
          <span class="w-[26px] h-[26px] rounded-full flex items-center justify-center text-xs font-bold text-[var(--color-txt-muted)] shrink-0" style="background:var(--color-bg-glass)"><%= index + 1 %></span>
          <span class="flex-1 text-sm text-[var(--color-txt-primary)] font-medium"><%= product.brand %> <%= product.name %></span>
          <div class="text-right"><div class="text-sm font-bold text-[var(--color-success)]">₹<%= number_with_delimiter(product.total_revenue.to_i) %></div><div class="text-xs text-[var(--color-txt-muted)]"><%= product.total_qty %> sold</div></div>
        </div>
      <% end %>
    <% else %><p class="text-[var(--color-txt-muted)]">No products sold this month.</p><% end %>
  </div>
</div>
